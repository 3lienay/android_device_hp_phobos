# Android fstab file for HP Slate 21 (phobos)
#<src>                                      <mnt>   <type>  <mnt_flags>                          <fs_mgr_flags>
/dev/block/platform/sdhci-tegra.3/by-name/LNX /boot  emmc    defaults                             recoveryonly
/dev/block/platform/sdhci-tegra.3/by-name/APP /system ext4   ro,barrier=1                         wait,avb
/dev/block/platform/sdhci-tegra.3/by-name/CAC /cache  ext4   noatime,nosuid,nodev,barrier=1       wait,check
/dev/block/platform/sdhci-tegra.3/by-name/UDA /data   ext4   noatime,nosuid,nodev,barrier=1       wait,check,encryptable=footer
/dev/block/platform/sdhci-tegra.3/by-name/TRD /vendor/app ext4 ro,barrier=1                       wait
