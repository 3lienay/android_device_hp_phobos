# BoardConfig.mk para HP Phobos - LineageOS 15.1

TARGET_BOARD_PLATFORM := msm8974

# Kernel
BOARD_KERNEL_CMDLINE := console=ttyS0,115200n8 androidboot.hardware=phobos
BOARD_KERNEL_BASE := 0x80000000
BOARD_KERNEL_PAGESIZE := 2048
BOARD_KERNEL_IMAGE_NAME := zImage
TARGET_KERNEL_SOURCE := kernel/hp/phobos
TARGET_KERNEL_CONFIG := 
TARGET_KERNEL_ARCH := arm


# CPU & GPU
# Arquitetura
TARGET_ARCH := arm
TARGET_ARCH_VARIANT := armv7-a-neon
TARGET_CPU_VARIANT := cortex-a9
TARGET_CPU_ABI := armeabi-v7a
TARGET_CPU_ABI2 := armeabi

# Board info
BOARD_VENDOR := hp
BOARD_MODEL := phobos

# Memory
BOARD_RAM_SIZE := 2GB

# Filesystem
BOARD_SYSTEMIMAGE_PARTITION_SIZE := 536870912
BOARD_USERDATAIMAGE_PARTITION_SIZE := 1073741824
BOARD_CACHEIMAGE_PARTITION_SIZE := 134217728

# Misc
BOARD_USES_RECOVERY := true
BOARD_USE_GYP_COMMON := false

