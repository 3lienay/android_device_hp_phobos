# Copyright (C) 2012 The Android Open Source Project
#
# IMPORTANT: Do not create world writable files or directories.
# This is a common source of Android security bugs.
#

import /init.environ.rc
import /init.usb.rc
import /init.${ro.hardware}.rc
import /init.${ro.zygote}.rc
import /init.trace.rc
# Include LineageOS extras
import /init.lineage.rc

on early-init
    # Set init and its forked children's oom_adj.
    write /proc/1/oom_score_adj -1000

    # Apply strict SELinux checking
    write /sys/fs/selinux/checkreqprot 0

    # Set the security context for init
    setcon u:r:init:s0
    restorecon /adb_keys

    start ueventd
    mkdir /mnt 0775 root system

on init
    sysclktz 0
    loglevel 3

    # Backward compatibility
    symlink /system/etc /etc
    symlink /sys/kernel/debug /d
    symlink /system/vendor /vendor

    # Cgroup mounts
    mkdir /acct
    mount cgroup none /acct cpuacct
    mkdir /acct/uid

    mkdir /sys/fs/cgroup
    mount tmpfs none /sys/fs/cgroup mode=0750,uid=0,gid=1000
    mkdir /sys/fs/cgroup/memory
    mount cgroup none /sys/fs/cgroup/memory memory
    write /sys/fs/cgroup/memory/memory.move_charge_at_immigrate 1
    chown root system /sys/fs/cgroup/memory/tasks
    chmod 0660 /sys/fs/cgroup/memory/tasks

    # Create base directories
    mkdir /system
    mkdir /data 0771 system system
    mkdir /cache 0770 system cache
    mkdir /config 0500 root root

    # Storage setup
    mkdir /mnt/shell 0700 shell shell
    mkdir /storage 0751 root sdcard_r
    mkdir /mnt/secure 0700 root root
    mkdir /mnt/asec 0700 root system
    mount tmpfs tmpfs /mnt/asec mode=0755,gid=1000

    # Memory control group
    mkdir /dev/memcg 0700 root system
    mount cgroup none /dev/memcg memory

    # Kernel settings
    write /proc/sys/kernel/panic_on_oops 1
    write /proc/sys/kernel/randomize_va_space 2
    write /proc/sys/kernel/kptr_restrict 2
    write /proc/sys/vm/mmap_min_addr 32768

on boot
    # Network init
    ifup lo
    hostname localhost
    domainname localdomain

    # Memory management
    write /proc/sys/vm/overcommit_memory 1
    write /proc/sys/vm/min_free_order_shift 4

    # Permissions for system controls
    chown radio system /sys/power/wake_lock
    chown radio system /sys/power/wake_unlock
    chmod 0660 /sys/power/state
    chmod 0660 /sys/power/wake_lock
    chmod 0660 /sys/power/wake_unlock

    # CPU settings
    chown system system /sys/devices/system/cpu/cpufreq/interactive/*
    chmod 0660 /sys/devices/system/cpu/cpufreq/interactive/*
    chown system system /sys/class/leds/*/brightness
    chown system system /sys/class/timed_output/vibrator/enable

    # Set default TCP window size
    setprop net.tcp.default_init_rwnd 60

    class_start core

on post-fs
    mount rootfs rootfs / ro remount
    mount rootfs rootfs / shared rec

    # Cache permissions
    chown system cache /cache
    chmod 0770 /cache
    restorecon_recursive /cache

    # /proc permissions
    chown root log /proc/vmallocinfo
    chmod 0440 /proc/vmallocinfo
    chown root log /proc/slabinfo
    chmod 0440 /proc/slabinfo
    chown root system /proc/kmsg
    chmod 0440 /proc/kmsg

on post-fs-data
    # Data permissions
    chown system system /data
    chmod 0771 /data
    restorecon /data

    # Create misc directories
    mkdir /data/misc 01771 system misc
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/vpn 0770 system vpn
    mkdir /data/misc/adb 02750 system shell
    mkdir /data/misc/keystore 0700 keystore keystore
    
    # WPA supplicant permissions
    chmod 0660 /data/misc/wifi/wpa_supplicant.conf
    
    # Dalvik cache
    mkdir /data/dalvik-cache 0771 root root

    # Security contexts
    restorecon_recursive /data
    setprop selinux.reload_policy 1

# Healthd handling
on property:sys.boot_from_charger_mode=1
    class_stop charger
    trigger late-init

# Property handling
on load_all_props_action
    load_all_props

on firmware_mounts_complete
    rm /dev/.booting

# Boot sequence
on late-init
    trigger early-fs
    trigger fs
    trigger post-fs
    trigger post-fs-data
    trigger load_all_props_action
    trigger firmware_mounts_complete
    trigger early-boot
    trigger boot

# Services definition
service ueventd /sbin/ueventd
    class core
    critical
    seclabel u:r:ueventd:s0

service logd /system/bin/logd
    class core
    socket logd stream 0666 logd logd
    seclabel u:r:logd:s0

service healthd /sbin/healthd
    class core
    critical
    seclabel u:r:healthd:s0

service lmkd /system/bin/lmkd
    class core
    critical
    socket lmkd seqpacket 0660 system system

service servicemanager /system/bin/servicemanager
    class core
    user system
    group system
    critical
    onrestart restart healthd
    onrestart restart zygote
    onrestart restart surfaceflinger

service surfaceflinger /system/bin/surfaceflinger
    class core
    user system
    group graphics drmrpc
    onrestart restart zygote

# Add your device-specific services below
# Example: service mydeviced /system/bin/mydeviced
#    class main
#    user root
#    group root

# Property triggers
on property:sys.powerctl=*
    powerctl ${sys.powerctl}

on charger
    class_start charger