# Android fstab file (LineageOS 15.1)
#<src>                                                  <mnt_point>         <type>    <mnt_flags>                                                                 <fs_mgr_flags>
/dev/block/platform/sdhci-tegra.3/by-name/APP           /system             ext4      ro,barrier=1,noatime,nodelalloc,nomblk_io_submit,errors=panic               wait,check
/dev/block/platform/sdhci-tegra.3/by-name/CAC           /cache              ext4      noatime,nosuid,nodev,noauto_da_alloc,data=ordered,barrier=1,errors=panic    wait,check
/dev/block/platform/sdhci-tegra.3/by-name/UDA           /data               ext4      noatime,nosuid,nodev,noauto_da_alloc,data=ordered,barrier=1,errors=panic    wait,check,formattable,encryptable=/dev/block/platform/sdhci-tegra.3/by-name/MDA
/dev/block/platform/sdhci-tegra.3/by-name/LNX           /boot               emmc      defaults                                                                      defaults
/dev/block/platform/sdhci-tegra.3/by-name/SOS           /recovery           emmc      defaults                                                                      defaults
/dev/block/platform/sdhci-tegra.3/by-name/USP           /staging            emmc      defaults                                                                      defaults
/dev/block/platform/sdhci-tegra.3/by-name/MDA           /metadata           emmc      defaults                                                                      defaults

# Armazenamento externo (FUSE)
/devices/platform/sdhci-tegra.2/mmc_host/mmc1*          auto                auto      defaults                                                                      voldmanaged=sdcard1:auto,noemulatedsd
/devices/platform/tegra-ehci.0*                         auto                auto      defaults                                                                      voldmanaged=usbdrive:auto,noemulatedsd
/devices/platform/tegra-ehci.2/usb1/1-1/1-1.2*          auto                auto      defaults                                                                      voldmanaged=usbdrive1:auto,noemulatedsd
/devices/platform/tegra-ehci.2/usb1/1-1/1-1.3*          auto                auto      defaults                                                                      voldmanaged=usbdrive2:auto,noemulatedsd