# /vendor/etc/init/init.trace.rc
on boot
    # Configurações específicas do Tegra para tracing
    write /sys/kernel/tracing/tracing_on 0
    write /sys/kernel/tracing/buffer_size_kb 1024
    write /sys/kernel/tracing/events/tegra/enable 1

service traced /system/bin/traced
    class late_start
    user system
    group system
    seclabel u:r:traced:s0
    # Prioridade reduzida para não impactar performance
    priority -10
    # Limitar uso de CPU
    rlimit rtprio 10 10

service trace_helper /system/bin/trace_helper
    class late_start
    user system
    group system
    seclabel u:r:trace_helper:s0
    priority -10
    rlimit rtprio 10 10

on property:persist.tracing.enable=1
    start traced
    start trace_helper
    write /sys/kernel/tracing/tracing_on 1

on property:persist.tracing.enable=0
    write /sys/kernel/tracing/tracing_on 0
    stop traced
    stop trace_helper