# Partição de Sistema
/dev/block/platform/sdhci-tegra.3/by-name/APP    /system    ext4    ro,noatime,errors=panic    wait

# Partição de Dados
/dev/block/platform/sdhci-tegra.3/by-name/UDA    /data      ext4    noatime,nosuid,nodev,noauto_da_alloc,errors=panic,commit=60    wait,check,encryptable=/dev/block/platform/sdhci-tegra.3/by-name/MDA

# Partição de Cache
/dev/block/platform/sdhci-tegra.3/by-name/CAC    /cache     ext4    noatime,nosuid,nodev,noauto_da_alloc,errors=panic    wait,check

# Vendor (bind mount para /system/vendor)
/system/vendor    /vendor    none    bind    0 0
