# HDCP Configuration for NVIDIA Tegra 3 - LineageOS 15.1
on post-fs-data
    # Set HDCP SRM properties
    setprop hdcp.srm.path       "/vendor/etc/hdcpsrm"
    setprop hdcp1x.srm.name     "hdcp1x.srm"
    setprop hdcp2x.srm.name     "hdcp2x.srm"
    setprop hdcp2xtest.srm.name "hdcp2xtest.srm"

    # Create HDCP SRM directory if needed
    mkdir /vendor/etc/hdcpsrm 0755 root root
    restorecon_recursive /vendor/etc/hdcpsrm

on boot
    # Load HDCP kernel module
    insmod /vendor/lib/modules/tegra_hdcp.ko
    chmod 0660 /dev/hdcp
    chown system drm /dev/hdcp

service hdcp /vendor/bin/hdcp
    class main
    user system
    group system drmrpc
    seclabel u:r:hdcp:s0
    oneshot